+def test_failures_do_not_silently_update_or_proceed():
+    theta, ys = jnp.array([0.4, -0.7, 0.2]), jnp.array(Y)
+    bad_opt = Optimizer(lambda _: (), lambda g, s, p: (jnp.full_like(p, jnp.nan), s))
