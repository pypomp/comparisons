#!/bin/bash
# Candidate only: parent must freeze scope/cap/protocol and review before sbatch.
#SBATCH --job-name=dacca-pypfilt-formal
#SBATCH --account=ionides3
#SBATCH --partition=standard
#SBATCH --cpus-per-task=4
#SBATCH --mem=24G
#SBATCH --time=08:00:00
#SBATCH --signal=B:TERM@60
#SBATCH --output=/scratch/ionides_root/ionides1/hkunyang/model024_20261006/competitor_estimation_20261028/pypfilt/formal_v1/logs/formal-%j.log
set -euo pipefail
export TASK_ALLOCATION_START=$(date +%s)
BASE=/scratch/ionides_root/ionides1/hkunyang/model024_20261006
TASK="$BASE/competitor_estimation_20261028/pypfilt/formal_v1"
module purge
module load gcc
source "$BASE/model024_panel_cute_20261023/venv/bin/activate"
export CUDA_VISIBLE_DEVICES=""
export JAX_PLATFORMS=cpu
export PYTHONPATH="$TASK/source:$TASK/../deps-linux:$BASE/cuthbert_dacca_paper_20261028/source:$BASE/cuthbert_dacca_20261027/deps"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export JAX_COMPILATION_CACHE_DIR="$TASK/jax_cache"
cd "$TASK"
python verify_manifest.py
# protocol.json must have status=frozen. Exec lets the pre-timeout SIGTERM
# reach the Python checkpoint handler directly.
exec python fit.py --protocol protocol.json --output results --allocation-seconds 28800
